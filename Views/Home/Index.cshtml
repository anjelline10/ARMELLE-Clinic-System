@{ViewData["Title"]="Owner Dashboard";}
<style>.oc{font-family:Segoe UI,Arial;color:#482c39}.oc .welcome{background:linear-gradient(115deg,#722d48,#a55472);color:#fff;padding:28px 32px;border-radius:19px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:15px}.oc .welcome h1{color:white;font-size:29px;margin:6px 0}.oc .welcome p{color:#ffe8f0}.oc .metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(185px,1fr));gap:14px;margin:23px 0}.oc .metric{display:block;background:#fff;border:1px solid #f0dfe5;border-radius:15px;padding:21px;text-decoration:none!important;color:#63384b!important;box-shadow:0 7px 22px #572d3a0b}.oc .metric:hover{transform:translateY(-2px);box-shadow:0 9px 28px #572d3a1b}.oc .metric strong{display:block;font-size:29px;color:#803851;margin-top:12px}.oc .metric small{font-size:12px;color:#8b7580}.oc .columns{display:grid;grid-template-columns:1.2fr 1fr;gap:18px}.oc .panel{background:white;border:1px solid #f0dfe5;border-radius:17px;padding:22px;margin-bottom:17px}.oc .panel h3{margin:0 0 15px;color:#67334a}.oc .btn{display:inline-flex;padding:11px 15px;background:#863d57;color:white!important;text-decoration:none!important;border-radius:10px;font-weight:650;margin:4px}.oc .btn.alt{background:#f9edf2;color:#803951!important}.oc .branch{display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid #f2e5eb}.oc .branch span{color:#9d8791}.oc .muted{color:#937e89;font-size:13px}@@media(max-width:800px){.oc .columns{grid-template-columns:1fr}}</style>
<div class="oc"><div class="welcome"><div><small>ARMELLE • OWNER COMMAND CENTER</small><h1>Welcome to ARMELLE</h1><p>Live operational statistics from your clinic database</p></div><div>@DateTime.Now.ToString("MMMM dd, yyyy")</div></div>
<div class="metrics"><a class="metric" href="/Clinic/Patients"><small>REGISTERED PATIENTS</small><strong>@ViewBag.Patients</strong></a><a class="metric" href="/Clinic/Appointments"><small>TODAY'S APPOINTMENTS</small><strong>@ViewBag.Today</strong></a><a class="metric" href="/Clinic/Appointments"><small>RESERVATIONS</small><strong>@ViewBag.Reservations</strong></a><a class="metric" href="/Clinic/Queue"><small>ACTIVE QUEUE</small><strong>@ViewBag.Queue</strong></a><a class="metric" href="/Clinic/Employees"><small>STAFF ON DUTY</small><strong>@ViewBag.Staff</strong></a><a class="metric" href="/Clinic/Doctors"><small>ACTIVE DOCTORS</small><strong>@ViewBag.Doctors</strong></a><a class="metric" href="/Clinic/Pharmacy"><small>LOW STOCK ITEMS</small><strong>@ViewBag.LowStock</strong></a><a class="metric" href="/Clinic/Laboratory"><small>LAB REQUESTS</small><strong>@ViewBag.Labs</strong></a></div>
<div class="columns"><div><div class="panel"><h3>Revenue & Financial Overview</h3><div class="branch"><b>Paid revenue (all branches)</b><b>₱@(((decimal)ViewBag.Revenue).ToString("N2"))</b></div><div class="branch"><b>Operating expenses</b><b>₱@(((decimal)ViewBag.Expenses).ToString("N2"))</b></div><p class="muted">Branch-level revenue cannot be calculated accurately until invoices store the branch. No estimated figures are presented as real.</p><a class="btn" href="/Home/DownloadRevenueCsv">↓ Download Revenue CSV</a><a class="btn alt" href="/Clinic/Reports">View Reports →</a></div><div class="panel"><h3>Branch Patient & Appointment Totals</h3>@foreach(var branch in new[]{"North QC","Central San Juan","South Makati"}){<div class="branch"><b>@branch</b><span>@(((Dictionary<string,int>)ViewBag.BranchPatients).GetValueOrDefault(branch)) patients · @(((Dictionary<string,int>)ViewBag.BranchAppointments).GetValueOrDefault(branch)) appointments</span></div>}</div></div><div><div class="panel"><h3>Clinic Operations</h3><div class="branch"><span>Employees</span><b>@ViewBag.Employees</b></div><div class="branch"><span>Appointments</span><b>@ViewBag.Appointments</b></div><div class="branch"><span>Medicines</span><b>@ViewBag.Medicines</b></div><div class="branch"><span>Invoices</span><b>@ViewBag.Invoices</b></div></div><div class="panel"><h3>Owner Shortcuts</h3><a class="btn alt" href="/Home/OwnerSettings">Owner Settings</a><a class="btn alt" href="/Home/PublicPreview">Public Website Preview</a><a class="btn alt" href="/Content">Edit Public Content</a></div></div></div></div>