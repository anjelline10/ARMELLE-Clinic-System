@{Layout="_PublicLayout";ViewData["Title"]="About ARMELLE";var s=ViewBag.AboutSection as string??"about";var pageTitle=s switch{"history"=>"Our History","mission"=>"Our Mission","vision"=>"Our Vision","values"=>"Core Values","facilities"=>"Our Facilities",_=>"About ARMELLE"};}
<section class="pagehero"><p class="eyebrow">ABOUT ARMELLE</p><h1>@pageTitle</h1><p>People, care and community—supported by accessible multi-specialty services and a modern patient experience.</p></section>
<section class="about-detail"><div class="about-copy">
@if(s=="history"){<h2>Care built around the patient.</h2><p>ARMELLE Multi-Specialty Center was envisioned as a coordinated outpatient clinic where patients and families can access different areas of care in a more convenient, organized and welcoming environment. Instead of making patients navigate disconnected processes, ARMELLE brings medical consultations, diagnostics, laboratory services, dental care, pharmacy, rehabilitation and patient support into one connected clinic experience.</p><p>As the center grows, its history page can document the official founding story, the opening of each branch, the addition of new specialties and diagnostic capabilities, and the milestones that helped ARMELLE serve more communities. The goal remains consistent: professional healthcare that feels modern and high-quality while staying approachable and transparent for everyday patients.</p><h3>Our continuing story</h3><ul><li>Building a patient-centered multi-specialty model</li><li>Expanding accessible specialty and diagnostic services</li><li>Developing branch-based care closer to communities</li><li>Using responsible technology to simplify appointments, records and support</li><li>Maintaining clear information and transparent configured prices</li></ul>}
else if(s=="mission"){<h2>Accessible, coordinated and compassionate care.</h2><p>ARMELLE's mission is to provide quality outpatient healthcare through compassionate professionals, coordinated medical services, responsible technology and clear patient communication. We aim to make every stage of the visit—from finding a doctor and understanding prices to consultation, diagnostics, pharmacy and follow-up—more convenient and understandable.</p><p>We strive to serve patients with respect, protect their privacy, support informed healthcare decisions and continuously improve the safety, efficiency and accessibility of our services.</p>}
else if(s=="vision"){<h2>A trusted center for healthier communities.</h2><p>ARMELLE envisions becoming a trusted multi-specialty healthcare center recognized for dependable care, accessible services, transparent information and a seamless patient experience. We envision branches where families can confidently find the right professional, understand available services and costs, and receive coordinated support in a comfortable modern clinical environment.</p>}
else if(s=="values"){<h2>Our Core Values</h2><div class="values-list"><h3>Care</h3><p>We place patient wellbeing, comfort and dignity at the center of the experience.</p><h3>Integrity</h3><p>We communicate responsibly, protect information and promote transparent service and pricing information.</p><h3>Respect</h3><p>We treat patients, families and colleagues with professionalism, fairness and compassion.</p><h3>Excellence</h3><p>We continuously improve clinical support, operations, technology and service quality.</p><h3>Community</h3><p>We aim to make coordinated healthcare more approachable and useful to the communities we serve.</p></div>}
else if(s=="facilities"){<h2>Designed for coordinated outpatient care.</h2><p>ARMELLE's facility concept combines welcoming patient areas with purpose-built clinical spaces. Depending on branch capability, patients can move from reception and consultation to laboratory, diagnostic imaging, dental care, pharmacy, rehabilitation, vaccination and other outpatient services within one organized environment.</p><p>Facility pages and galleries can show patients what to expect before they arrive—including reception areas, waiting spaces, specialty consultation rooms, examination areas, laboratory and imaging rooms, dental facilities, pharmacy, rehabilitation spaces and other patient-support areas.</p><div class="mini-links"><a href="/Public/Gallery">Open Complete Gallery</a><a href="/Public/Locations">Explore Branches</a></div>}
else{<h2>People. Care. Community.</h2><p>ARMELLE Multi-Specialty Center is a modern outpatient healthcare concept designed to make coordinated care easier to access. Patients can explore doctors and specialties, compare configured service prices, view branches and facilities, book appointments, use patient resources and receive support through one connected experience.</p><p>ARMELLE combines a professional clinical environment with an approachable atmosphere—high-quality in presentation and service while remaining focused on practical, transparent and accessible care for patients and families.</p>}
</div><div class="about-photo-grid">@for(var i=1;i<=4;i++){var imagePath=$"/images/facilities/about-{i}.svg";var slotKey=$"about-{s}-{i}";<div class="visual-card"><div class="about-upload-photo"><partial name="_EditablePublicPhoto" model="@(new Armelle.Models.EditablePhotoSlot { Key=slotKey, DefaultPath=imagePath, Alt=$"ARMELLE {pageTitle} photo {i}" })" /></div><span>@pageTitle • Photo @i</span></div>}</div></section>
