<section class="pagehero"><p class="eyebrow">ARMELLE GALLERY</p><h1>Complete Facilities Gallery</h1><p>Explore ARMELLE clinic facilities and departments.</p></section>
@if (canEdit)
{
    <section style="margin:20px auto;max-width:1100px;padding:20px;border:2px solid #e7b7c8;border-radius:16px;background:#fff4f8">
      <h2>Owner Gallery Management</h2><p>Upload a new clinic photo or replace any gallery image below. Changes appear immediately for public visitors and patients.</p>
      @if (Context.Request.Query.ContainsKey("updated")) { <p style="color:green">Gallery photo saved successfully.</p> }
      <form asp-controller="Public" asp-action="UploadGallery" method="post" enctype="multipart/form-data" style="display:flex;gap:10px;flex-wrap:wrap;align-items:center">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="0" />
        <input name="title" placeholder="New photo title" maxlength="150" required style="padding:10px" />
        <input name="photo" type="file" accept="image/jpeg,image/png,image/webp" required />
        <button type="submit" style="background:#933b63;color:white;padding:10px 20px;border:0;border-radius:8px">Upload New Photo</button>
      </form>
    </section>
}
<section class="fullgallery">
@foreach (var item in galleryItems)
{
  <article>
    <img src="@item.ImagePath" alt="@item.Title" loading="lazy" />
    <h3>@item.Title</h3><span>ARMELLE facility gallery</span>
    @if (canEdit)
    {
      <details style="margin:12px 0;padding:10px;border:1px solid #e9c9d5;border-radius:10px;background:#fff">
        <summary style="cursor:pointer;color:#883957;font-weight:bold">Replace / Edit Photo</summary>
        <form asp-controller="Public" asp-action="UploadGallery" method="post" enctype="multipart/form-data" style="display:grid;gap:8px;margin-top:12px">
          @Html.AntiForgeryToken()
          <input type="hidden" name="id" value="@item.Id" />
          <input name="title" value="@item.Title" maxlength="150" required aria-label="Photo title" />
          <input name="photo" type="file" accept="image/jpeg,image/png,image/webp" required />
          <button type="submit" style="background:#933b63;color:white;padding:9px;border:0;border-radius:8px">Save Photo</button>
        </form>
        @if (item.IsCustom)
        {
          <form asp-controller="Public" asp-action="DeleteGallery" method="post" onsubmit="return confirm('Remove this uploaded photo?')" style="margin-top:8px">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@item.Id" />
            <button type="submit">@(item.Id <= 95 ? "Restore Default Photo" : "Delete Photo")</button>
          </form>
        }
      </details>
    }
  </article>
}
</section>