@model List<Doctor>
@{Layout="_PublicLayout";ViewData["Title"]="Find a Doctor";var specialties=Model.Select(x=>x.Specialty).Where(x=>!string.IsNullOrWhiteSpace(x)).Distinct().OrderBy(x=>x).ToList();var selected=Context.Request.Query["specialty"].ToString();}
<section class="pagehero doctor-search-hero"><p class="eyebrow">FIND A DOCTOR</p><h1>Choose the right doctor for your care.</h1><p>Filter by specialty, then open a doctor's card to see branch, room, consultation fee, clinic schedule, current status and booking option—all in one place.</p></section>
<section class="doctor-tools"><form method="get"><label>Specialty</label><select name="specialty" onchange="this.form.submit()"><option value="">All Specialties</option>@foreach(var s in specialties){<option value="@s" selected="@(selected==s)">@s</option>}</select><a href="/Public/Doctors">Clear Filter</a></form><div class="specialty-chips"><a class="@(string.IsNullOrWhiteSpace(selected)?"active":"")" href="/Public/Doctors">All</a>@foreach(var s in specialties){<a class="@(selected==s?"active":"")" href="/Public/Doctors?specialty=@Uri.EscapeDataString(s)">@s</a>}</div></section>
<section class="doctorgrid">@if(!Model.Any()){<article><h3>No doctor found</h3><p>Try another specialty or contact ARMELLE for assistance.</p></article>}@foreach(var x in Model){<article class="doctor-card-pro"><div class="doctorphoto">@if(!string.IsNullOrWhiteSpace(x.PhotoPath)){<img src="@Url.Content(x.PhotoPath)" alt="Photo of @x.Name" loading="lazy" style="width:100%;height:100%;object-fit:cover;border-radius:inherit" onerror="this.style.display='none';this.nextElementSibling.style.display='grid'" /><span style="display:none">DR</span>}else{<span>DR</span>}</div><div class="doctor-card-body"><small>@x.Branch</small><h3>@x.Name</h3><b>@x.Specialty</b><div class="doctor-facts"><span><strong>Room</strong>@x.Room</span><span><strong>Consultation</strong>₱@x.ConsultationFee.ToString("N0")</span><span><strong>Clinic Schedule</strong>@x.Schedule</span><span><strong>Availability</strong><i class="pill">@x.Status</i></span></div><a class="primarylink" href="/Public/Book">Book Appointment</a></div></article>}</section>
