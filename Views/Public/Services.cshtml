@model List<ClinicService>
@{Layout="_PublicLayout";ViewData["Title"]="Services & Prices";var groups=Model.GroupBy(x=>x.Category).OrderBy(x=>x.Key).ToList();}
<section class="pagehero"><p class="eyebrow">AFFORDABLE • TRANSPARENT • PATIENT-FIRST</p><h1>All Services & Prices</h1><p>Browse ARMELLE services with their current configured base prices. Search any consultation, test, procedure, diagnostic service, dental care, rehabilitation, vaccination or other available service.</p><form><input name="q" value="@Context.Request.Query["q"]" placeholder="Search service, department or procedure..."><button class="primary">Search</button><a class="outline" href="/Public/Services">Show All</a></form></section>
@if(!Model.Any()){<section class="publiccards"><article><h3>No matching service found</h3><p>Clear the search or ask ARMELLE for assistance.</p></article></section>}
@foreach(var g in groups){<section class="service-category"><div class="sectionhead-inline"><div><p class="eyebrow">@g.Key</p><h2>@g.Key</h2></div><span>@g.Count() service(s)</span></div><div class="service-price-grid">@foreach(var x in g){<article><small>@x.Category</small><h3>@x.Name</h3><p>@x.Description</p><div class="price-row"><b>₱@x.Price.ToString("N2")</b><span>@x.Status</span></div></article>}</div></section>}
