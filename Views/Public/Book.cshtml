@model BookingPageVm
@{Layout="_PublicLayout";ViewData["Title"]="Book Care";}
<section class="pagehero"><p class="eyebrow">SMART RESERVATION</p><h1>Choose the care you need. We assign the clinical team.</h1><p>Select only your ARMELLE branch, service and preferred date. The system assigns the earliest available qualified doctor and protected time slot based on capacity, so patients are not double-booked.</p>
@if(ViewBag.BookError!=null){<div class="errorbox">@ViewBag.BookError</div>}
@if(Model.Result!=null){<div class="bookingresult"><span class="pill">RESERVED</span><h2>@Model.Result.ReferenceNo</h2><div class="resultgrid"><div><small>Branch</small><b>@Model.Result.Branch</b></div><div><small>Service</small><b>@Model.Result.Service</b></div><div><small>Assigned Physician</small><b>@Model.Result.Doctor</b></div><div><small>Schedule</small><b>@Model.Result.Start.ToString("MMM dd, yyyy • h:mm tt")–@Model.Result.End.ToString("h:mm tt")</b></div><div><small>Room</small><b>@Model.Result.Room</b></div><div><small>Payment</small><b>@Model.Result.PaymentStatus</b></div></div>@if(Model.Result.Nurses.Any()){<p><b>Clinical team:</b> @string.Join(" • ",Model.Result.Nurses)</p>}<p class="fine">Online payment is confirmed only after ARMELLE verifies the submitted proof.</p></div>}
<form method="post" enctype="multipart/form-data" class="booking booking-modern"><input name="Patient" placeholder="Patient full name" required><input name="Contact" placeholder="Mobile / email" required><select name="Branch" required><option value="">Choose branch</option>@foreach(var b in Model.Branches){<option value="@b.Name">@b.Name</option>}</select><select name="Service" required><option value="">Choose service / specialty</option>@foreach(var s in Model.Services){<option value="@s.Name">@s.Name — ₱@s.Price.ToString("N2")</option>}</select><input name="PreferredDate" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" required><select id="paymentMethod" name="PaymentMethod"><option>Pay at Clinic</option><option>GCash</option><option>Maya</option><option>Card / Online Transfer</option></select><label class="proof"><span>Proof of payment <small>(required for online payment)</small></span><input id="proofInput" type="file" name="PaymentProof" accept="image/*,.pdf"></label><button class="primary">Find Earliest Schedule & Reserve</button></form><p class="fine">You do not manually choose a doctor or exact time. ARMELLE assigns the earliest open schedule on your selected date. Cancellation, refund and late rules follow the clinic's configured policy.</p></section>
<script>const pm=document.getElementById('paymentMethod'),pf=document.getElementById('proofInput');function req(){pf.required=pm.value!=='Pay at Clinic'}pm.addEventListener('change',req);req();</script>
