@model List<ResourceItem>
@{Layout="_PublicLayout";ViewData["Title"]="Patient Resources"; var c=(string)(ViewBag.Category??""); var key=string.IsNullOrWhiteSpace(c)?"Guide":c; var title=key switch{"HMO"=>"HMO Assistance","PhilHealth"=>"PhilHealth Guide","Price"=>"Price Transparency","Laboratory"=>"Laboratory Preparation Guide","Imaging"=>"X-Ray & Diagnostic Preparation","Pharmacy"=>"Pharmacy Guide","Rights"=>"Patient Rights","FAQ"=>"Health Library & FAQs","Appointment"=>"Appointment & Cancellation Guide",_=>"Patient Guide"}; var img=key.ToLowerInvariant();}
<section class="pagehero"><p class="eyebrow">PATIENT RESOURCES</p><h1>@title</h1><p>Clear information before your visit, with space for approved ARMELLE photos and branch-specific guidance.</p></section>
<section class="resource-detail"><div class="resource-copy">
@if(Model.Any()){foreach(var x in Model){<article><small>@x.Category</small><h2>@x.Title</h2><p>@x.Content</p></article>}}else if(key=="Guide"){<h2>Your ARMELLE Patient Guide</h2><p>This guide helps patients understand what to do before, during and after a clinic visit so the experience is simple and organized.</p><h3>Before your visit</h3><ul><li>Choose a doctor/service and branch, then check the doctor's displayed clinic schedule and availability.</li><li>Book online or ask about walk-in availability.</li><li>Bring a valid ID and relevant medical records, prescriptions, laboratory results or referral documents.</li><li>Bring HMO/PhilHealth documents when applicable.</li></ul><h3>At the clinic</h3><ul><li>Proceed to Reception/Patient Services for registration or check-in.</li><li>Receive your queue information and wait for your assigned room/department.</li><li>Ask staff about transparent service prices before proceeding.</li></ul><h3>After your visit</h3><ul><li>Review prescriptions, laboratory/imaging requests and follow-up instructions.</li><li>Use the Patient Portal for available records, appointments, billing and support.</li></ul>}
else if(key=="PhilHealth"){<h2>PhilHealth Guide</h2><p>ARMELLE can publish its actual PhilHealth accreditation, applicable benefits and branch procedures here once officially configured.</p><ul><li>Membership/eligibility guidance</li><li>Required valid IDs and PhilHealth documents</li><li>Applicable services and benefit guidance</li><li>Verification and claims-assistance steps</li><li>Branch assistance desk/contact</li></ul>}
else if(key=="HMO"){<h2>HMO Assistance</h2><p>Check configured HMO partners, required documents and verification steps before your consultation or procedure.</p><ul><li>Participating HMO partners</li><li>Letter of authorization/approval requirements where applicable</li><li>Covered-service guidance</li><li>Branch verification process</li><li>Patient assistance contact</li></ul>}
else if(key=="Price"){<h2>Price Transparency</h2><p>ARMELLE is designed to show configured base prices clearly so patients can plan before visiting.</p><ul><li>Consultation fees by doctor/service</li><li>Laboratory, imaging, dental and procedure prices</li><li>Pharmacy medicine prices and availability</li><li>Package inclusions</li><li>Possible additional charges explained before service</li></ul><a class="primarylink" href="/Public/Services">View All Services & Prices</a>}
else if(key=="Laboratory"){<h2>Laboratory Preparation Guide</h2><ul><li>Check whether fasting is required for the selected test.</li><li>Follow specimen collection instructions.</li><li>Bring the doctor's request when required.</li><li>Confirm branch schedule and test availability.</li><li>Ask when and where results will be released.</li></ul>}
else if(key=="Imaging"){<h2>X-Ray & Diagnostic Preparation</h2><ul><li>Confirm the exact requested examination.</li><li>Bring the doctor's request and relevant previous results.</li><li>Follow exam-specific clothing/preparation guidance.</li><li>Inform staff of relevant safety considerations before the procedure.</li><li>Check result-release instructions.</li></ul>}
else if(key=="Pharmacy"){<h2>Pharmacy Guide</h2><p>Prescription medicines are reviewed by authorized pharmacy staff before final dispensing.</p><ul><li>Upload or present the prescription.</li><li>Wait for pharmacist verification and medicine matching.</li><li>Review medicine name, strength, quantity, stock and transparent price.</li><li>Review the computed total before payment/pickup.</li><li>Present applicable discount documents when required.</li></ul>}
else if(key=="Rights"){<h2>Patient Rights</h2><ul><li>Privacy and confidentiality</li><li>Respect and non-discrimination</li><li>Clear information about care and prices</li><li>Informed consent and the right to ask questions</li><li>Safe care and appropriate referral</li><li>Feedback and complaint channels</li></ul>}
else if(key=="Appointment"){<h2>Appointment & Cancellation Guide</h2><p>These rules keep schedules fair for patients and healthcare staff. Authorized administrators can update the final clinic policy.</p><h3>Booking</h3><ul><li>Select the branch and required service, then choose a valid date.</li><li>Doctor/slot availability is confirmed by the system before reservation.</li><li>Keep the appointment reference number.</li></ul><h3>Rescheduling & cancellation</h3><ul><li>Reschedule or cancel as early as possible before the scheduled visit.</li><li>A cancelled slot may be released to another patient.</li><li>Repeated no-shows may require staff assistance before another reservation.</li><li>Late arrival may result in a later queue position or rescheduling when the doctor can no longer accommodate the patient.</li><li>Any payment/refund policy follows the payment status and the clinic's approved rules.</li></ul>}
else{<h2>Health Library & FAQs</h2><ul><li>Appointments and walk-ins</li><li>Payments and transparent prices</li><li>HMO and PhilHealth guidance</li><li>Laboratory, imaging and pharmacy</li><li>Doctors, specialties and branches</li><li>AI and live human support</li></ul>}
<button class="primary" onclick="document.getElementById('aiFab').click()">Ask ARMELLE AI about this</button></div><aside class="resource-picture"><div class="resource-photo-grid">@for(var i=1;i<=4;i++){<figure>@await Html.PartialAsync("_EditablePublicPhoto", new Armelle.Models.EditablePhotoSlot { Key = $"resource-{img}-{i}", DefaultPath = $"/images/resources/{img}.svg", Alt = $"{title} image {i}" })<figcaption>@title • Photo slot @i</figcaption></figure>}</div><p>The Owner can upload approved ARMELLE photos for these four image slots.</p></aside></section>
