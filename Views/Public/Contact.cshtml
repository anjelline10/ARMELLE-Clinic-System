@{Layout="_PublicLayout";ViewData["Title"]="Contact";}
<section class="pagehero visualhero"><div><p class="eyebrow">CONTACT & SUPPORT</p><h1>We're here when you need us.</h1><p>Contact ARMELLE through the channel that is most convenient for you. The Owner can update all official contact details from content management.</p><button onclick="document.getElementById('aiFab').click()" class="primary">Ask ARMELLE / Talk to Agent</button></div><div class="photo-placeholder" style="min-height:280px;padding:0;overflow:hidden">@await Html.PartialAsync("_EditablePublicPhoto", new Armelle.Models.EditablePhotoSlot { Key = "contact-main", DefaultPath = "", Alt = "ARMELLE Contact / Reception Photo" })</div></section>
<section class="contactgrid"><article><h3>Phone & Mobile</h3><p><strong>Main:</strong> Add official clinic number</p><p><strong>Branch lines:</strong> Maintained per branch</p></article><article><h3>Email</h3><p><strong>Patient Support:</strong> Add official email</p><p><strong>Appointments:</strong> Add official email</p></article><article><h3>Social Media</h3><p>Facebook • Messenger • Instagram</p><p>Only verified official ARMELLE profile links should be published.</p></article><article><h3>Live Support</h3><p>Use Ask ARMELLE, then choose <strong>Talk to Agent</strong>. Relevant chat context can be passed to the support workspace so the patient does not need to repeat the concern.</p><button onclick="document.getElementById('aiFab').click()" class="primary">Open Live Support</button></article></section>
