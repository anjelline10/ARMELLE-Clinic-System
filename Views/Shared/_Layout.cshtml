@{var owner = Context.Session.GetString("OwnerDisplayName") ?? Context.Session.GetString("User") ?? "Owner"; var ownerPhoto=Context.Session.GetString("OwnerPhoto");}
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>ARMELLE | @ViewData["Title"]</title><link rel="stylesheet" href="/css/site.css"><style>
.arm-header,.arm-header *{box-sizing:border-box}.arm-header{position:relative;z-index:1000;background:#fff;border-bottom:1px solid #f1dce4;box-shadow:0 4px 24px #57283a12;font-family:Segoe UI,Arial,sans-serif}.arm-bar{max-width:1500px;margin:auto;display:flex;align-items:center;gap:16px;padding:12px 25px;flex-wrap:wrap}.arm-logo{display:flex;align-items:center;gap:10px;color:#813951;text-decoration:none!important;white-space:nowrap}.arm-logo img{width:38px;height:38px;object-fit:contain}.arm-logo strong{font-size:18px;letter-spacing:1px}.arm-logo small{display:block;font-size:10px;color:#a47d8c}.arm-nav{display:flex!important;align-items:center!important;flex-direction:row!important;flex-wrap:wrap!important;gap:3px!important;flex:1!important}.arm-nav a,.arm-nav button,.arm-actions button,.arm-actions a{font:600 13px Segoe UI,Arial!important;color:#65364a!important;background:transparent!important;border:0!important;text-decoration:none!important;border-radius:9px!important;padding:10px 12px!important;cursor:pointer!important;white-space:nowrap!important;display:inline-flex!important;align-items:center!important;gap:5px!important}.arm-nav a:hover,.arm-nav button:hover,.arm-actions button:hover{background:#f9edf2!important}.arm-drop{position:relative!important;display:block!important}.arm-drop>section{display:none!important;position:absolute!important;top:calc(100% + 5px)!important;left:0!important;min-width:240px!important;max-height:70vh;overflow:auto;flex-direction:column!important;background:white!important;border:1px solid #efdce4!important;border-radius:13px!important;padding:8px!important;box-shadow:0 16px 40px #4d223329!important;z-index:3000!important}.arm-drop[data-open="true"]>section{display:flex!important}.arm-drop>section>a{width:100%!important;white-space:normal!important}.arm-actions{display:flex;align-items:center;gap:4px;margin-left:auto}.arm-actions .arm-drop>section{left:auto!important;right:0!important;min-width:290px!important}.arm-actions .arm-drop>section .arm-notice{padding:12px;border-bottom:1px solid #f3e5eb;font-size:13px;color:#61384b}.arm-actions .arm-drop>section .arm-notice:last-child{border:0}.arm-actions .arm-signout{background:#873d57!important;color:white!important}.arm-main{max-width:1500px;margin:0 auto;padding:22px 24px 50px;min-height:80vh}.arm-back{display:inline-flex;padding:9px 13px;background:#f9edf2;color:#853952;border-radius:9px;text-decoration:none;font:600 13px Segoe UI,Arial;margin-bottom:14px}.arm-main>h2{font-family:Segoe UI,Arial;color:#512c3a;font-size:22px;margin:6px 0 20px}@@media(max-width:950px){.arm-bar{padding:10px}.arm-nav{order:3;flex-basis:100%!important;overflow:visible}.arm-nav a,.arm-nav button{font-size:12px!important;padding:8px!important}.arm-actions .arm-drop>section{right:0!important}}@@media(max-width:600px){.arm-actions{gap:0}.arm-logo strong{font-size:15px}.arm-drop>section{min-width:210px!important}}
</style></head><body>
<header class="arm-header"><div class="arm-bar"><a class="arm-logo" href="/Home"><img src="/images/armelle-logo.png" alt="ARMELLE"><span><strong>ARMELLE</strong><small>Multi-Specialty Center</small></span></a><nav class="arm-nav" aria-label="Owner navigation"><a href="/Home">⌂ Owner Home</a>
<div class="arm-drop"><button type="button" aria-expanded="false">Clinical ▾</button><section><a href="/Clinic/Patients">Patients</a><a href="/Clinic/Appointments">Appointments & Walk-ins</a><a href="/Clinic/Queue">QR Check-In / Queue</a><a href="/Clinic/Consultations">Consultations</a></section></div>
<div class="arm-drop"><button type="button" aria-expanded="false">Diagnostics ▾</button><section><a href="/Clinic/Laboratory">Laboratory & Diagnostics</a><a href="/Clinic/Pharmacy">Pharmacy & Inventory</a></section></div>
<div class="arm-drop"><button type="button" aria-expanded="false">People ▾</button><section><a href="/Clinic/Employees">Employees & Attendance</a><a href="/Clinic/Payroll">Payroll</a></section></div>
<div class="arm-drop"><button type="button" aria-expanded="false">Finance ▾</button><section><a href="/Clinic/Billing">Billing / POS</a><a href="/Clinic/Expenses">Expenses</a><a href="/Clinic/Reports">Reports & Analytics</a></section></div>
<div class="arm-drop"><button type="button" aria-expanded="false">Manage ▾</button><section><a href="/Promotions">Discounts &amp; Promos</a><a href="/Content">Edit Public Content</a><a href="/Home/PublicPreview">Public Website Preview</a><a href="/Support">Talk to Agent</a></section></div></nav>
<div class="arm-actions"><div class="arm-drop"><button type="button" aria-label="Notifications" aria-expanded="false">🔔 Notifications</button><section><div class="arm-notice"><b>Appointments</b><div>View incoming reservations</div><a href="/Clinic/Appointments">Open appointments →</a></div><div class="arm-notice"><b>Inventory</b><div>Review medicine stock alerts</div><a href="/Clinic/Pharmacy">Open inventory →</a></div><div class="arm-notice"><b>Staff attendance</b><div>Review workforce check-in</div><a href="/Clinic/Employees">Open attendance →</a></div></section></div><div class="arm-drop"><button type="button" aria-expanded="false">@if(!string.IsNullOrWhiteSpace(ownerPhoto)){<img src="@ownerPhoto" alt="Owner" style="width:26px;height:26px;object-fit:cover;border-radius:50%"/>} ⚙ @owner ▾</button><section><a href="/Home/OwnerSettings">Owner Settings</a><a href="/Clinic/Employees">Manage Staff</a><a href="/Clinic/Doctors">Manage Doctors</a></section></div><a class="arm-signout" href="/Auth/Logout">Logout</a></div></div></header>
<main class="arm-main">@if((string?)ViewContext.RouteData.Values["controller"]!="Home" || (string?)ViewContext.RouteData.Values["action"]!="Index"){<a class="arm-back" href="/Home">← Back to Owner Home</a>}<h2>@ViewData["Title"]</h2>@RenderBody()</main>
<script>document.querySelectorAll('.arm-drop>button').forEach(b=>{b.addEventListener('click',e=>{e.stopPropagation();const p=b.parentElement;const open=p.dataset.open==='true';document.querySelectorAll('.arm-drop').forEach(x=>{x.dataset.open='false';x.querySelector('button')?.setAttribute('aria-expanded','false')});p.dataset.open=String(!open);b.setAttribute('aria-expanded',String(!open))})});document.addEventListener('click',e=>{if(!e.target.closest('.arm-drop'))document.querySelectorAll('.arm-drop').forEach(x=>{x.dataset.open='false';x.querySelector('button')?.setAttribute('aria-expanded','false')})});</script></body></html>