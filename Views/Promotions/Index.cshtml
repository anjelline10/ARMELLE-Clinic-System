@model List<Armelle.Models.ClinicPromotion>
@using Armelle.Models
@{Layout="_Layout";ViewData["Title"]="Discounts & Promos";var audits=ViewBag.History as List<PromotionAudit> ?? new();var redemptions=ViewBag.Redemptions as List<PromotionRedemption> ?? new();}
<style>.promo-panel{background:white;border:1px solid #eedce4;border-radius:14px;padding:20px;margin:16px 0}.promo-form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.promo-form label{display:grid;gap:5px;font-weight:600}.promo-form input,.promo-form select,.promo-form textarea{padding:10px;border:1px solid #decbd2;border-radius:8px}.promo-form button,.promo-action{background:#a94d6b;color:white;border:0;padding:10px 15px;border-radius:8px;cursor:pointer}.promo-table{width:100%;border-collapse:collapse}.promo-table th,.promo-table td{padding:10px;text-align:left;border-bottom:1px solid #eee}.promo-panel{overflow-x:auto}@@media(max-width:650px){.promo-form{grid-template-columns:1fr}}</style>
<section class="promo-panel"><h3>Create promotion</h3><form method="post" action="/Promotions/Save" class="promo-form">@Html.AntiForgeryToken()<label>Title<input name="title" maxlength="120" required /></label><label>Promo code<input name="promoCode" maxlength="50" /></label><label>Description<textarea name="description" maxlength="1000"></textarea></label><label>Discount type<select name="discountType"><option value="Percent">Percentage (%)</option><option value="Amount">Fixed amount (₱)</option></select></label><label>Discount value<input name="discountValue" type="number" min="0" step="0.01" required /></label><label>Start date<input name="startsAt" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" required /></label><label>End date<input name="endsAt" type="date" value="@DateTime.Today.AddDays(30).ToString("yyyy-MM-dd")" required /></label><label><span>Publish on public website</span><input name="isPublished" type="checkbox" value="true" /></label><button type="submit">Save promotion</button></form></section>
<section class="promo-panel"><h3>Manage promotions</h3><table class="promo-table"><thead><tr><th>Promotion</th><th>Discount</th><th>Valid</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var p in Model){<tr><td><strong>@p.Title</strong><div>@p.PromoCode</div><small>@p.Description</small><details><summary>Edit</summary><form method="post" action="/Promotions/Save" class="promo-form">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id"/><label>Title<input name="title" value="@p.Title" required /></label><label>Code<input name="promoCode" value="@p.PromoCode" /></label><label>Description<textarea name="description">@p.Description</textarea></label><label>Type<select name="discountType"><option value="Percent" selected="@(p.DiscountType=="Percent")">Percent</option><option value="Amount" selected="@(p.DiscountType=="Amount")">Amount</option></select></label><label>Value<input name="discountValue" type="number" step="0.01" min="0" value="@p.DiscountValue" required /></label><label>Starts<input name="startsAt" type="date" value="@p.StartsAt.ToString("yyyy-MM-dd")" required /></label><label>Ends<input name="endsAt" type="date" value="@p.EndsAt.ToString("yyyy-MM-dd")" required /></label><label>Published<input type="checkbox" name="isPublished" value="true" checked="@p.IsPublished" /></label><button>Save changes</button></form></details></td><td>@p.DiscountValue @(p.DiscountType=="Percent"?"%":"PHP")</td><td>@p.StartsAt.ToString("MMM d") – @p.EndsAt.ToString("MMM d, yyyy")</td><td>@(p.IsPublished?"Published":"Draft")</td><td><form method="post" action="/Promotions/SetPublished">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id"/><input type="hidden" name="published" value="@(!p.IsPublished?"true":"false")"/><button class="promo-action">@(p.IsPublished?"Unpublish":"Publish")</button></form></td></tr>}</tbody></table></section>
<section class="promo-panel"><h3>Record a patient's actual promo redemption</h3><p>Enter the patient's AppUser ID and an invoice/appointment reference after confirming eligibility and the discount.</p><form class="promo-form" method="post" action="/Promotions/RecordRedemption">@Html.AntiForgeryToken()<label>Promotion<select name="promotionId">@foreach(var p in Model.Where(x=>x.IsPublished&&x.StartsAt.Date<=DateTime.Today&&x.EndsAt.Date>=DateTime.Today)){<option value="@p.Id">@p.Title</option>}</select></label><label>Patient AppUser ID<input name="patientUserId" type="number" min="1" required /></label><label>Invoice / appointment reference<input name="reference" maxlength="120" required /></label><button>Record redemption</button></form></section>
<section class="promo-panel"><h3>Owner activity history</h3><table class="promo-table"><tr><th>Date (UTC)</th><th>Owner</th><th>Action</th><th>Details</th></tr>@foreach(var a in audits){<tr><td>@a.AtUtc.ToString("yyyy-MM-dd HH:mm")</td><td>@a.OwnerUsername</td><td>@a.Action</td><td>@a.Details</td></tr>}</table></section>
<section class="promo-panel"><h3>Patient redemption history</h3><table class="promo-table"><tr><th>Date (UTC)</th><th>Promotion ID</th><th>Patient account ID</th><th>Reference</th></tr>@foreach(var r in redemptions){<tr><td>@r.RedeemedAtUtc.ToString("yyyy-MM-dd HH:mm")</td><td>@r.PromotionId</td><td>@r.PatientUserId</td><td>@r.Reference</td></tr>}</table></section>
