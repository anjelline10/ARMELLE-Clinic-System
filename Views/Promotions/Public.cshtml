@model List<Armelle.Models.ClinicPromotion>
@{Layout="_PublicLayout";ViewData["Title"]="Discounts & Promos";}
<section style="max-width:1100px;margin:35px auto;padding:24px"><h1 style="color:#a94d6b">Discounts & Promos</h1><p>Current published ARMELLE clinic offers. Final eligibility and billing are verified by the clinic.</p><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:18px">@foreach(var p in Model){<article style="padding:24px;background:#fff;border:1px solid #eedce4;border-radius:14px"><h2>@p.Title</h2><strong style="color:#a94d6b;font-size:23px">@(p.DiscountType=="Percent"?$"{p.DiscountValue:0.##}% OFF":$"₱{p.DiscountValue:N2} OFF")</strong><p>@p.Description</p>@if(!string.IsNullOrWhiteSpace(p.PromoCode)){<p>Code: <strong>@p.PromoCode</strong></p>}<small>Valid until @p.EndsAt.ToString("MMMM dd, yyyy")</small></article>}</div>@if(!Model.Any()){<p>No active promotions at this time.</p>}</section>
