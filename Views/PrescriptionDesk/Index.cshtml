@using Armelle.Models
@model IEnumerable<Consultation>
@{ Layout = null; var patients = ViewBag.Patients as IEnumerable<Patient> ?? Enumerable.Empty<Patient>(); var releases = ViewBag.Releases as IEnumerable<PrescriptionRelease> ?? Enumerable.Empty<PrescriptionRelease>(); }
<!DOCTYPE html><html><head><meta charset="utf-8"><title>ARMELLE | Owner Prescription Desk</title><style>body{font-family:Segoe UI,Arial;background:#fff8fb;color:#39313a;margin:30px auto;max-width:1150px;padding:0 20px}h1,h2{color:#963f61}.panel{background:white;border:1px solid #ecd9e1;border-radius:12px;padding:22px;margin:18px 0}input,select,textarea{display:block;box-sizing:border-box;width:100%;padding:10px;margin:7px 0 14px;border:1px solid #ddd;border-radius:7px}button,.btn{display:inline-block;background:#a94d6b;color:white;padding:10px 17px;border:0;border-radius:8px;text-decoration:none;cursor:pointer}table{border-collapse:collapse;width:100%}td,th{padding:11px;border-bottom:1px solid #eee;text-align:left}small{color:#765} .msg{padding:12px;background:#fff2e8}</style></head><body>
<a href="/Clinic/Patients">← Back to Owner Patients</a><h1>ARMELLE — Prescription Desk</h1><p>Record a physician's prescription as draft, then release it only after authentic physician authorization. Released prescriptions appear in the correct patient's private portal automatically.</p>
@if(TempData["PrescriptionError"] != null){<p class="msg">@TempData["PrescriptionError"]</p>}@if(TempData["PrescriptionMessage"] != null){<p class="msg">@TempData["PrescriptionMessage"]</p>}
<div class="panel"><h2>1. Add prescription draft</h2><form method="post" action="/PrescriptionDesk/Create">@Html.AntiForgeryToken()<label>Patient</label><select name="patient" required><option value="">Select patient</option>@foreach(var p in patients){<option value="@p.Name">@p.Name</option>}</select><label>Prescribing physician</label><input name="doctor" required maxlength="120"><label>Diagnosis</label><textarea name="diagnosis"></textarea><label>Prescription details (medication, dose, frequency, duration)</label><textarea name="prescription" rows="5" required></textarea><label>Notes</label><textarea name="notes"></textarea><button type="submit">Save draft</button></form></div>
<div class="panel"><h2>2. Review and release</h2><p>Optional physician-signed PDF/photo may be attached. Without physician approval, leave as draft.</p><table><thead><tr><th>Patient / Date</th><th>Physician / Prescription</th><th>Status and action</th></tr></thead><tbody>@foreach(var c in Model){var released=releases.Any(r=>r.ConsultationId==c.Id);<tr><td>@c.Patient<br><small>@c.Date.ToString("yyyy-MM-dd")</small></td><td>@c.Doctor<br><small>@c.Prescription</small></td><td>@if(released){<strong>Released</strong> <a href="/PatientRecords/DownloadPrescriptionPdf/@c.Id">PDF</a>}else if(!string.IsNullOrWhiteSpace(c.Prescription)){<form method="post" enctype="multipart/form-data" action="/PrescriptionDesk/UploadApproved">@Html.AntiForgeryToken()<input type="hidden" name="consultationId" value="@c.Id"><input name="physicianName" placeholder="Approving physician's name" required><input name="licenseNumber" placeholder="Physician license number" required><label>Signed prescription (optional PDF/photo)</label><input type="file" name="document" accept=".pdf,.png,.jpg,.jpeg,.webp"><label><input type="checkbox" name="confirmed" value="true" required style="display:inline;width:auto"> I confirm genuine physician authorization was obtained</label><button type="submit">Release to patient</button></form>}else{<small>No prescription</small>}</td></tr>}</tbody></table></div></body></html>