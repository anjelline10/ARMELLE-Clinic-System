            <strong>✦ Ask ARMELLE AI</strong>
            <button onclick="toggleChat()">×</button>
        </div>

        <div id="chatMessages" class="chat-messages">
            <div class="chat-message">
                Hello! I can help with ARMELLE
                doctors, branches, services,
                appointments, and patient resources.
            </div>
        </div>

        <form class="chat-form"
              onsubmit="sendChat(event)">

            <input id="chatInput"
                   type="text"
                   placeholder="Ask ARMELLE..."
                   required />

            <button type="submit">
                <i class="fa-solid fa-paper-plane"></i>
            </button>
        </form>
    </div>

    <script>

            // Reuse the real public views, CSS and database-driven content.
            // The patient header and sidebar stay visible at all times.
            const portalRoutes = {
                doctors:'/Public/Doctors', resources:'/Public/Resources',
                branches:'/Public/Locations', about:'/Public/About',
                contact:'/Public/Contact', gallery:'/Public/Gallery',
                team:'/Public/Team', services:'/Public/Services',
                booking:'/Public/Book'
            };
            function openPublic(section, url) {
                const panel=document.getElementById(section);
                if (!panel) return;
                const frame=panel.querySelector('iframe');
                if(frame){
                    const next=url || portalRoutes[section];
                    if(next && frame.dataset.loadedUrl!==next){
                        frame.src=next;
                        frame.dataset.loadedUrl=next;
                    }
                }
                showPage(section);
            }
            function preparePublicFrame(frame){
                try {
                    const doc=frame.contentDocument;
                    if(!doc || !doc.body) return;
                    const css=doc.createElement('style');
                    css.textContent=`
                        header.pubnav, header.site-header, header.public-header, .public-nav,
                        .site-nav, .navbar, .main-nav, .public-navbar,
                        .floating-ai, #aiFab, #aiBox, #aiChat, .ai-fab,
                        footer, .pubfooter, .site-footer {display:none!important}
                        html{overflow:hidden!important} body.public{padding-top:0!important;margin:0!important;overflow:hidden!important} .pubmain{padding-top:0!important;margin-top:0!important}
                    `;
                    doc.head.appendChild(css);
                    // The real public layout uses .pubnav, .pubfooter, and #aiFab.
                    // Fit the embedded document to its content: one scroll bar only.
                    const resize=()=>{
                        if(!frame.isConnected || !doc.body) return;
                        frame.style.height='1px';
                        const h=Math.max(doc.body.scrollHeight,doc.documentElement.scrollHeight,600);
                        frame.style.height=(h+16)+'px';
                    };
                    resize();
                    if(frame._portalResizeObserver) frame._portalResizeObserver.disconnect();
                    if(typeof ResizeObserver!=='undefined'){
                        frame._portalResizeObserver=new ResizeObserver(resize);
                        frame._portalResizeObserver.observe(doc.body);
                    }
                    doc.querySelectorAll('img').forEach(img=>img.addEventListener('load',resize,{once:true}));
                    frame._portalResize=resize;
                    doc.querySelectorAll('a[href]').forEach(a=>{
                        a.addEventListener('click',event=>{
                            const dest=new URL(a.href,window.location.href);
                            if(dest.origin!==window.location.origin) return;
                            if(!dest.pathname.startsWith('/Public/')) return;
                            const path=dest.pathname.toLowerCase();
                            let section=path.includes('/book')?'booking':
                                path.includes('/doctor')?'doctors':
                                path.includes('/location')?'branches':
                                path.includes('/gallery')?'gallery':
                                path.includes('/team')?'team':
                                path.includes('/service')?'services':
                                path.includes('/resource')?'resources':
                                path.includes('/contact')?'contact':
                                path.includes('/about')?'about':null;
                            if(section){event.preventDefault();openPublic(section,dest.pathname+dest.search+dest.hash);}
                        });
                    });
                    // Public AI links should use the patient assistant.
                    doc.querySelectorAll('[onclick*="aiFab"]').forEach(b=>{
                        b.removeAttribute('onclick');
                        b.addEventListener('click',()=>toggleChat());
                    });
                }catch(e){console.warn('Unable to customize public content frame',e);}
            }
            document.querySelectorAll('.public-content-frame').forEach(frame=>{
                frame.addEventListener('load',()=>preparePublicFrame(frame));
            });


            // Frontend-only profile controls. No false database-success messages.
            let patientPhotoUrl=null;
            const originalPhotoHtml=document.getElementById('profileAvatarPreview').innerHTML;
            function previewPatientPhoto(input){
                const file=input.files && input.files[0];if(!file)return;
                if(!['image/jpeg','image/png','image/webp'].includes(file.type)||file.size>2*1024*1024){
                    alert('Please select a JPG, PNG, or WebP image up to 2 MB.');input.value='';return;
                }
                if(patientPhotoUrl)URL.revokeObjectURL(patientPhotoUrl);
                patientPhotoUrl=URL.createObjectURL(file);
                const img=document.createElement('img');img.src=patientPhotoUrl;img.alt='Patient photo preview';
                document.getElementById('profileAvatarPreview').replaceChildren(img);
                document.getElementById('removePhotoFlag').value='false';
            }
            function removePatientPhoto(){
                document.getElementById('profilePhotoInput').value='';
                document.getElementById('removePhotoFlag').value='true';
                if(patientPhotoUrl){URL.revokeObjectURL(patientPhotoUrl);patientPhotoUrl=null;}
                document.getElementById('profileAvatarPreview').innerHTML='<i class="fa-regular fa-user"></i>';
                profileNotice('profileFeedback','Click Save Changes to remove the photo permanently.');
            }
            function profileNotice(id,message){const el=document.getElementById(id);el.textContent=message;el.classList.add('visible');}
            async function postPatientForm(form){
                const response=await fetch(form.action,{method:'POST',body:new FormData(form),credentials:'same-origin'});
                let data={};try{data=await response.json();}catch{}
                if(!response.ok||!data.saved)throw new Error(data.message||'Unable to save. Please try again.');
                return data;
            }
            async function preparePatientProfile(event){
                event.preventDefault();const form=event.target;if(!form.reportValidity())return;
                const button=form.querySelector('button[type="submit"]');button.disabled=true;
                profileNotice('profileFeedback','Saving to MySQL...');
                try{
                    const data=await postPatientForm(form);
                    document.getElementById('profileDisplayName').textContent=data.fullName;
                    if(data.photoPath){const img=document.createElement('img');img.src=data.photoPath;img.alt='Patient photo';document.getElementById('profileAvatarPreview').replaceChildren(img);}
                    else document.getElementById('profileAvatarPreview').innerHTML='<i class="fa-regular fa-user"></i>';
                    document.getElementById('removePhotoFlag').value='false';
                    document.getElementById('profilePhotoInput').value='';
                    profileNotice('profileFeedback','Saved successfully to MySQL.');
                }catch(error){profileNotice('profileFeedback',error.message);}finally{button.disabled=false;}
            }
            function resetPatientProfileUI(){
                document.getElementById('removePhotoFlag').value='false';
                document.getElementById('profilePhotoInput').value='';
                document.getElementById('profileAvatarPreview').innerHTML=originalPhotoHtml;
                document.getElementById('profileFeedback').classList.remove('visible');
            }
            function togglePatientPassword(id,button){
                const input=document.getElementById(id);input.type=input.type==='password'?'text':'password';
                button.setAttribute('aria-label',input.type==='password'?'Show password':'Hide password');
                button.querySelector('i').className=input.type==='password'?'fa-regular fa-eye':'fa-regular fa-eye-slash';
            }
            async function preparePasswordChange(event){
                event.preventDefault();const form=event.target;
                const next=document.getElementById('profileNewPassword').value;
                const confirm=document.getElementById('profileConfirmPassword').value;
                if(next!==confirm){profileNotice('passwordFeedback','New password and confirmation do not match.');return;}
                const button=form.querySelector('button[type="submit"]');button.disabled=true;
                profileNotice('passwordFeedback','Updating password...');
                try{await postPatientForm(form);form.reset();profileNotice('passwordFeedback','Password updated successfully.');}
                catch(error){profileNotice('passwordFeedback',error.message);}finally{button.disabled=false;}
            }

            function showPage(pageId) {

                const target = document.getElementById(pageId);
                if (!target || !target.classList.contains('page'))
                    return;

                document.querySelectorAll('.page')
                    .forEach(page => {
                        page.classList.remove('active');
                    });

                document.querySelectorAll('.menu-btn')
                    .forEach(button => {
                        button.classList.remove('active');
                    });

                target.classList.add('active');

                const menu = document.querySelector(
                    '.menu-btn[data-page="' + pageId + '"]'
                );

                if (menu) {
                    menu.classList.add('active');
                }

                window.scrollTo(0, 0);
            }

            function toggleChat() {
                document.getElementById('patientChat')
                    .classList.toggle('open');
            }

            function addChatMessage(message, sender) {
                const container =
                    document.getElementById('chatMessages');

                const div = document.createElement('div');
                div.className =
                    'chat-message' +
                    (sender === 'user' ? ' user' : '');

                div.textContent = message;
                container.appendChild(div);

                container.scrollTop =
                    container.scrollHeight;
            }

            async function sendChat(event) {
                event.preventDefault();

                const input = document.getElementById('chatInput');
                const question = input.value.trim();

                if (!question) return;

                addChatMessage(question, 'user');
                input.value = '';

                try {
                    const response = await fetch('/Public/AskAi', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            question: question
                        })
                    });

                    if (!response.ok) {
                        throw new Error('AI request failed');
                    }

                    const data = await response.json();

                    addChatMessage(
                        data.answer || 'No response available.',
                        'bot'
                    );

                } catch (error) {
                    addChatMessage(
                        'Unable to connect to ARMELLE AI right now.',
                        'bot'
                    );
                }
            }
    </script>

</body>
</html>


