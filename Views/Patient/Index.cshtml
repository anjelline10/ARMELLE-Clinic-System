@using Armelle.Models
@using System.Linq

@{
    Layout = null;
    ViewData["Title"] = "Patient Dashboard";

    var appointments = ViewBag.Upcoming as IEnumerable<Appointment>
        ?? Enumerable.Empty<Appointment>();

    var labs = ViewBag.Labs as IEnumerable<LabRequest>
        ?? Enumerable.Empty<LabRequest>();

    var bills = ViewBag.Bills as IEnumerable<Invoice>
        ?? Enumerable.Empty<Invoice>();

    var historyAppointments = ViewBag.HistoryAppointments as IEnumerable<Appointment> ?? Enumerable.Empty<Appointment>();
    var historyConsultations = ViewBag.HistoryConsultations as IEnumerable<Consultation> ?? Enumerable.Empty<Consultation>();
    var historyPrescriptions = ViewBag.HistoryPrescriptions as IEnumerable<Consultation> ?? Enumerable.Empty<Consultation>();
    var historyLabs = ViewBag.HistoryLabs as IEnumerable<LabRequest> ?? Enumerable.Empty<LabRequest>();
    var historyTransactions = ViewBag.HistoryTransactions as IEnumerable<Invoice> ?? Enumerable.Empty<Invoice>();
    var patientName = ViewBag.User?.ToString() ?? "Patient";
    var savedProfile = ViewBag.Profile as PatientProfile;
    var displayName = !string.IsNullOrWhiteSpace(savedProfile?.FullName) ? savedProfile.FullName : patientName;

    var totalAppointments = ViewBag.TotalAppointments is int ta
        ? ta : appointments.Count();

    var totalLabs = ViewBag.TotalLabs is int tl
        ? tl : labs.Count();

    var totalBills = ViewBag.TotalBills is int tb
        ? tb : bills.Count();

    var totalPromos = ViewBag.TotalPromos is int tp
        ? tp : 0;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>ARMELLE | Patient Dashboard</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

    <style>
            :root {
                --rose: #a94d6b;
                --darkrose: #81374f;
                --blush: #f7e8ed;
                --ivory: #fffaf7;
                --text: #343039;
                --muted: #827780;
                --border: #f0dfe5;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                background: var(--ivory);
                font-family: 'Segoe UI', Arial, sans-serif;
                color: var(--text);
            }

            button, input {
                font: inherit;
            }

            button {
                cursor: pointer;
            }

            a {
                text-decoration: none;
            }

            .topbar {
                height: 76px;
                background: white;
                border-bottom: 1px solid var(--border);
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 15px;
                padding: 0 30px;
                position: sticky;
                top: 0;
                z-index: 100;
            }

            .brand {
                display: flex;
                align-items: center;
                gap: 12px;
                cursor: pointer;
            }

                .brand img {
                    width: 48px;
                    height: 48px;
                    object-fit: contain;
                }

                .brand strong {
                    color: var(--rose);
                    font-size: 21px;
                    letter-spacing: 2px;
                }

                .brand small {
                    display: block;
                    color: #888;
                    font-size: 10px;
                }

            .topnav {
                display: flex;
                align-items: center;
                gap: 18px;
            }

                .topnav a,
                .topnav button {
                    color: #544b52;
                    border: none;
                    background: none;
                    font-size: 13px;
                    font-weight: 600;
                }

                    .topnav a:hover,
                    .topnav button:hover {
                        color: var(--rose);
                    }

            .topicon {
                position: relative;
                font-size: 19px !important;
                color: var(--rose) !important;
            }

            .avatar {
                background: var(--blush) !important;
                color: var(--rose) !important;
                border-radius: 30px;
                padding: 10px 14px;
            }

            .layout {
                display: grid;
                grid-template-columns: 235px minmax(0, 1fr);
                min-height: calc(100vh - 76px);
            }

            .sidebar {
                background: white;
                border-right: 1px solid var(--border);
                padding: 24px 13px;
                position: sticky;
                top: 76px;
                height: calc(100vh - 76px);
                overflow-y: auto;
            }

            .sidebar-title {
                color: #9c8a94;
                font-size: 11px;
                letter-spacing: 2px;
                padding: 8px 13px 17px;
            }

            .menu-btn {
                width: 100%;
                display: flex;
                align-items: center;
                gap: 13px;
                padding: 13px 14px;
                border: 0;
                border-radius: 11px;
                background: transparent;
                text-align: left;
                color: #625861;
                font-size: 13px;
                margin-bottom: 5px;
            }

                .menu-btn i {
                    width: 19px;
                    font-size: 16px;
                }

                .menu-btn:hover,
                .menu-btn.active {
                    background: var(--blush);
                    color: var(--rose);
                    font-weight: 700;
                }

            .sidebar-divider {
                border-top: 1px solid var(--border);
                margin: 16px 5px;
            }

            .main {
                padding: 26px 30px;
                width: 100%;
                min-width: 0;
            }

            .page {
                display: none;
            }

                .page.active {
                    display: block;
                }

            .hero {
                min-height: 180px;
                border-radius: 18px;
                padding: 30px;
                display: flex;
                align-items: center;
                color: white;
                background: linear-gradient(90deg, rgba(83, 36, 55, .95), rgba(123, 65, 88, .75), rgba(123, 65, 88, .18)), url('https://images.unsplash.com/photo-1551076805-e1869033e561?auto=format&fit=crop&w=1400&q=80') center / cover;
            }

                .hero small {
                    color: #ffe1eb;
                    letter-spacing: 2px;
                    font-size: 11px;
                    font-weight: 700;
                }

                .hero h1 {
                    margin: 10px 0;
                    font-size: clamp(23px, 3vw, 33px);
                    color: white;
                }

                .hero p {
                    margin: 0;
                    font-size: 13px;
                    color: #fff0f5;
                }

            .stats {
                display: grid;
                grid-template-columns: repeat(4, minmax(0, 1fr));
                gap: 15px;
                margin-top: 20px;
            }

            .stat,
            .panel,
            .quick,
            .promo-card {
                background: white;
                border: 1px solid var(--border);
                border-radius: 15px;
            }

            .stat {
                padding: 20px;
            }

            .stat-icon {
                background: var(--blush);
                color: var(--rose);
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 40px;
                height: 40px;
                border-radius: 12px;
                font-size: 19px;
            }

            .stat p {
                color: var(--muted);
                font-size: 12px;
                margin: 12px 0 5px;
            }

            .stat h2 {
                color: var(--rose);
                font-size: 27px;
                margin: 0;
            }

            .section-title {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 10px;
                margin: 23px 0 13px;
            }

                .section-title h2 {
                    margin: 0;
                    font-size: 19px;
                }

            .quick-grid {
                display: grid;
                grid-template-columns: repeat(3, minmax(0, 1fr));
                gap: 13px;
            }

            .quick {
                text-align: left;
                padding: 18px;
                cursor: pointer;
                transition: .2s;
            }

                .quick:hover {
                    border-color: var(--rose);
                    transform: translateY(-2px);
                }

                .quick i {
                    color: var(--rose);
                    background: var(--blush);
                    border-radius: 11px;
                    padding: 13px;
                    font-size: 18px;
                    margin-bottom: 12px;
                }

                .quick strong {
                    display: block;
                    font-size: 14px;
                }

                .quick small {
                    display: block;
                    color: var(--muted);
                    font-size: 12px;
                    margin-top: 7px;
                }

            .promo-strip {
                margin-top: 18px;
                padding: 16px 20px;
                background: var(--blush);
                border-radius: 13px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 15px;
            }

                .promo-strip strong {
                    color: var(--darkrose);
                }

                .promo-strip p {
                    color: #856775;
                    margin: 6px 0 0;
                    font-size: 12px;
                }

            .btn {
                border: none;
                border-radius: 10px;
                background: var(--rose);
                color: white;
                padding: 11px 16px;
                font-size: 13px;
                font-weight: 600;
                display: inline-block;
                cursor: pointer;
            }

                .btn:hover {
                    background: var(--darkrose);
                }

            .btn-back {
                background: var(--blush);
                color: var(--rose);
            }

                .btn-back:hover {
                    background: #edd5de;
                }

            .page-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 15px;
                margin-bottom: 20px;
            }

                .page-header h1 {
                    margin: 0;
                    font-size: 24px;
                }

            .panel {
                padding: 24px;
                margin-bottom: 17px;
            }

                .panel h3 {
                    margin-top: 0;
                    font-size: 17px;
                }

            .muted {
                color: var(--muted);
                font-size: 13px;
                line-height: 1.7;
            }

            .record {
                border-bottom: 1px solid var(--border);
                padding: 15px 0;
                font-size: 14px;
                line-height: 1.7;
            }

                .record:last-child {
                    border-bottom: none;
                }

                .record small {
                    color: var(--muted);
                }

            .pill {
                background: var(--blush);
                color: var(--rose);
                padding: 5px 10px;
                border-radius: 20px;
                font-size: 11px;
                font-weight: 700;
            }

            .info-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 17px;
            }

            .promo-grid {
                display: grid;
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 17px;
            }

            .promo-card {
                overflow: hidden;
            }

                .promo-card img {
                    width: 100%;
                    height: 160px;
                    object-fit: cover;
                }

            .promo-card-body {
                padding: 19px;
            }

            .promo-card h3 {
                margin: 12px 0;
            }

            .notice {
                background: #fff5f8;
                border: 1px solid #f0d7e0;
                border-radius: 12px;
                padding: 15px;
                color: #795666;
                font-size: 13px;
                line-height: 1.7;
            }

            .chat-fab {
                position: fixed;
                bottom: 23px;
                right: 25px;
                background: var(--rose);
                color: white;
                border: none;
                padding: 15px 20px;
                border-radius: 30px;
                box-shadow: 0 10px 25px #a94d6b35;
                z-index: 150;
            }

            .chatbox {
                display: none;
                position: fixed;
                bottom: 85px;
                right: 25px;
                width: min(360px, calc(100vw - 30px));
                height: 430px;
                background: white;
                border: 1px solid var(--border);
                border-radius: 17px;
                box-shadow: 0 15px 45px #0002;
                z-index: 151;
                overflow: hidden;
                flex-direction: column;
            }

                .chatbox.open {
                    display: flex;
                }

            .chat-head {
                background: var(--rose);
                color: white;
                padding: 16px;
                display: flex;
                justify-content: space-between;
            }

                .chat-head button {
                    background: transparent;
                    border: none;
                    color: white;
                    font-size: 20px;
                }

            .chat-messages {
                flex: 1;
                overflow-y: auto;
                padding: 15px;
                font-size: 13px;
                line-height: 1.6;
            }

            .chat-message {
                margin-bottom: 12px;
                background: #f8edf1;
                padding: 10px;
                border-radius: 10px;
                overflow-wrap: anywhere;
            }

                .chat-message.user {
                    background: #eee;
                }

            .chat-form {
                display: flex;
                padding: 10px;
                border-top: 1px solid var(--border);
                gap: 8px;
            }

                .chat-form input {
                    flex: 1;
                    min-width: 0;
                    padding: 10px;
                    border: 1px solid #ddd;
                    border-radius: 9px;
                }

                .chat-form button {
                    background: var(--rose);
                    color: white;
                    border: none;
                    border-radius: 9px;
                    padding: 10px;
                }

            @@media (max-width: 1050px) {
                .topnav .optional {
                    display: none;
                }

                .stats {
                    grid-template-columns: repeat(2, 1fr);
                }
            }

            @@media (max-width: 800px) {
                .layout {
                    grid-template-columns: 1fr;
                }

                .sidebar {
                    position: static;
                    height: auto;
                    display: flex;
                    overflow-x: auto;
                    gap: 6px;
                    padding: 10px;
                }

                .sidebar-title,
                .sidebar-divider {
                    display: none;
                }

                .menu-btn {
                    white-space: nowrap;
                    width: auto;
                    margin: 0;
                }

                .main {
                    padding: 18px;
                }
            }

            @@media (max-width: 550px) {
                .stats,
                .quick-grid,
                .info-grid,
                .promo-grid {
                    grid-template-columns: 1fr;
                }

                .topbar {
                    padding: 0 12px;
                }

                .topnav {
                    gap: 8px;
                }

                    .topnav .optional {
                        display: none;
                    }

                .brand strong {
                    font-size: 16px;
                }

                .promo-strip {
                    flex-direction: column;
                    align-items: flex-start;
                }

                .page-header {
                    align-items: flex-start;
                    flex-direction: column;
                }
            }

        /* Public page content displayed within patient portal */
        .public-portal-page{padding:0!important;max-width:none!important}
        .portal-page-head{display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap;padding:20px 24px;background:#fff;border-radius:15px;margin-bottom:12px}
        .portal-page-head h2{margin:3px 0;color:#8f4260;font-size:23px}
        .portal-page-head small{font-size:11px;letter-spacing:2px;color:#b26780}
        .portal-page-head button{border:1px solid #ebcbd6;background:#fff6f9;color:#944760;padding:11px 16px;border-radius:10px;cursor:pointer;font-weight:700}
        .public-content-frame{display:block;width:100%;height:1100px;min-height:600px;border:0;background:#fff;border-radius:14px}

            /* Patient profile settings */
            .profile-layout{display:grid;grid-template-columns:minmax(220px,280px) minmax(0,1fr);gap:20px;align-items:start}
            .profile-avatar-panel{text-align:center;display:flex;flex-direction:column;align-items:center;gap:10px}
            .profile-avatar{width:124px;height:124px;border-radius:50%;display:grid;place-items:center;background:var(--blush);border:4px solid #fff;box-shadow:0 0 0 1px var(--border);color:var(--rose);font-size:52px;overflow:hidden}
            .profile-avatar img{width:100%;height:100%;object-fit:cover}
            .profile-avatar-panel h3{margin:4px 0 0;overflow-wrap:anywhere}
            .profile-upload-btn{display:inline-flex;align-items:center;gap:8px;background:var(--rose);color:#fff;padding:11px 16px;border-radius:10px;cursor:pointer}
            .profile-link{border:0;background:none;color:var(--rose);text-decoration:underline;cursor:pointer}
            .profile-info-note{background:#fff6ec;border:1px solid #f1d5ae;color:#79562b;padding:12px;border-radius:10px;text-align:left;font-size:12px;line-height:1.5;margin-top:10px}
            .profile-main{display:grid;gap:20px;min-width:0}.profile-main .panel{margin:0}.profile-main h3{color:var(--darkrose)}
            .profile-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin:18px 0}
            .profile-field{display:flex;flex-direction:column;gap:7px;min-width:0}.profile-field label{font-size:13px;font-weight:650}.profile-field label span{color:#b12c45}
            .profile-field input,.profile-field select,.profile-field textarea{width:100%;min-width:0;padding:12px 13px;border:1px solid #e5d6dc;border-radius:10px;background:#fff;color:var(--text);font:inherit;outline:none}
            .profile-field input:focus,.profile-field select:focus,.profile-field textarea:focus{border-color:var(--rose);box-shadow:0 0 0 3px #a94d6b18}
            .profile-wide{grid-column:1/-1}.profile-section-title{border-top:1px solid var(--border);padding-top:20px;margin-top:24px}
            .profile-actions{display:flex;justify-content:flex-end;gap:10px;flex-wrap:wrap;margin-top:22px}.profile-save{background:var(--rose);color:white;border:0;padding:12px 20px;border-radius:10px}
            .profile-password{position:relative}.profile-password input{padding-right:44px}.profile-password button{position:absolute;right:6px;top:50%;transform:translateY(-50%);border:0;background:transparent;color:var(--muted);padding:9px}
            .profile-feedback{display:none;padding:12px;border-radius:9px;font-size:13px;background:#fff6ec;color:#79562b;border:1px solid #f1d5ae}.profile-feedback.visible{display:block}
            @@media(max-width:900px){.profile-layout{grid-template-columns:1fr}.profile-avatar-panel{max-width:none}}
            @@media(max-width:580px){.profile-fields{grid-template-columns:1fr}.profile-wide{grid-column:auto}}

    </style>
</head>

<body>
<div style="background:#fff3f8;padding:12px;text-align:center"><a style="font-weight:bold;color:#8e3457" href="/PatientRecords">My Profile · Appointments · Receipts · Prescriptions · Lab Results</a></div>

    <!-- HEADER -->
    <header class="topbar">

        <div class="brand" onclick="showPage('dashboard')">
            <img src="/images/armelle-logo.png"
                 alt="ARMELLE Logo" />

            <div>
                <strong>ARMELLE</strong>
                <small>Multi-Specialty Center</small>
            </div>
        </div>

        <nav class="topnav" aria-label="Clinic navigation">

            <button onclick="showPage('dashboard')">
                Home
            </button>

            <button type="button" onclick="openPublic('doctors')">Doctors</button>

            <button type="button" onclick="openPublic('resources')">Resources</button>

            <button type="button" onclick="openPublic('branches')">Branches</button>

            <button type="button" onclick="openPublic('about')">About</button>

            <button type="button" onclick="openPublic('contact')">Contact</button>

            <button class="topicon"
                    onclick="showPage('notifications')"
                    title="Notifications">
                <i class="fa-regular fa-bell"></i>
            </button>

            <button class="avatar"
                    onclick="showPage('profile')">
                <i class="fa-regular fa-user"></i>
            </button>
        </nav>
    </header>

    <div class="layout">

        <!-- SIDEBAR -->
        <aside class="sidebar">

            <div class="sidebar-title">PATIENT MENU</div>

            <button class="menu-btn active"
                    data-page="dashboard"
                    onclick="showPage('dashboard')">
                <i class="fa-solid fa-house"></i>
                Dashboard
            </button>

            <button class="menu-btn"
                    onclick="openPublic('booking')">
                <i class="fa-regular fa-calendar-plus"></i>
                Book Appointment
            </button>

            <button class="menu-btn"
                    data-page="appointments"
                    onclick="showPage('appointments')">
                <i class="fa-regular fa-calendar-check"></i>
                My Appointments
            </button>

            <button class="menu-btn"
                    data-page="records"
                    onclick="showPage('records')">
                <i class="fa-regular fa-folder-open"></i>
                Medical Records
            </button>

            <button class="menu-btn"
                    data-page="labs"
                    onclick="showPage('labs')">
                <i class="fa-solid fa-flask"></i>
                Laboratory Results
            </button>

            <button class="menu-btn"
                    data-page="billing"
                    onclick="showPage('billing')">
                <i class="fa-regular fa-credit-card"></i>
                Billing & Payments
            </button>

            <button class="menu-btn"
                    data-page="promos"
                    onclick="showPage('promos')">
                <i class="fa-solid fa-gift"></i>
                Discounts & Promos
            </button>

            <button class="menu-btn"
                    data-page="profile"
                    onclick="showPage('profile')">
                <i class="fa-regular fa-user"></i>
                Profile Settings
            </button>

            <div class="sidebar-divider"></div>

            <button class="menu-btn"
                    onclick="toggleChat()">
                <i class="fa-solid fa-robot"></i>
                Ask ARMELLE AI
            </button>

            <button class="menu-btn"
                    onclick="location.href='/Auth/Logout'">
                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                Logout
            </button>
        </aside>

        <!-- CONTENT -->
        <main class="main">

            <!-- DASHBOARD -->
            <section id="doctors" class="page public-portal-page">
                <div class="portal-page-head"><div><small>ARMELLE PATIENT PORTAL</small><h2>Meet Our Doctors</h2></div><button type="button" onclick="showPage('dashboard')">← Back to Dashboard</button></div>
                <iframe class="public-content-frame" title="Meet Our Doctors" data-url="/Public/Doctors" loading="lazy"></iframe>
            </section>
            <section id="resources" class="page public-portal-page">
                <div class="portal-page-head"><div><small>ARMELLE PATIENT PORTAL</small><h2>Patient Resources</h2></div><button type="button" onclick="showPage('dashboard')">← Back to Dashboard</button></div>
                <iframe class="public-content-frame" title="Patient Resources" data-url="/Public/Resources" loading="lazy"></iframe>
            </section>
            <section id="branches" class="page public-portal-page">
                <div class="portal-page-head"><div><small>ARMELLE PATIENT PORTAL</small><h2>Explore Locations</h2></div><button type="button" onclick="showPage('dashboard')">← Back to Dashboard</button></div>
                <iframe class="public-content-frame" title="Explore Locations" data-url="/Public/Locations" loading="lazy"></iframe>
            </section>
            <section id="about" class="page public-portal-page">
                <div class="portal-page-head"><div><small>ARMELLE PATIENT PORTAL</small><h2>About ARMELLE</h2></div><button type="button" onclick="showPage('dashboard')">← Back to Dashboard</button></div>
                <iframe class="public-content-frame" title="About ARMELLE" data-url="/Public/About" loading="lazy"></iframe>
            </section>
            <section id="contact" class="page public-portal-page">
                <div class="portal-page-head"><div><small>ARMELLE PATIENT PORTAL</small><h2>Contact Us</h2></div><button type="button" onclick="showPage('dashboard')">← Back to Dashboard</button></div>
                <iframe class="public-content-frame" title="Contact Us" data-url="/Public/Contact" loading="lazy"></iframe>
            </section>
            <section id="gallery" class="page public-portal-page">
                <div class="portal-page-head"><div><small>ARMELLE PATIENT PORTAL</small><h2>Facilities Gallery</h2></div><button type="button" onclick="showPage('dashboard')">← Back to Dashboard</button></div>
                <iframe class="public-content-frame" title="Facilities Gallery" data-url="/Public/Gallery" loading="lazy"></iframe>
            </section>
            <section id="team" class="page public-portal-page">
                <div class="portal-page-head"><div><small>ARMELLE PATIENT PORTAL</small><h2>Our Medical Team</h2></div><button type="button" onclick="showPage('dashboard')">← Back to Dashboard</button></div>
                <iframe class="public-content-frame" title="Our Medical Team" data-url="/Public/Team" loading="lazy"></iframe>
            </section>
