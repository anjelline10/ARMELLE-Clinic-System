@{ViewData["Title"]="Owner · Website Content";var services=(List<ClinicService>)ViewBag.Services;var locations=(List<ClinicLocation>)ViewBag.Locations;var resources=(List<ResourceItem>)ViewBag.Resources;}
<h1>Public Website Content · Owner CRUD</h1><p>All changes save to MySQL and are shown on the public pages. Nothing is preloaded here.</p>
<div class="panel"><h3>Add Clinic Service</h3><form method="post" action="/Content/AddService" class="form">@Html.AntiForgeryToken()<input name="Name" required placeholder="Service"><input name="Category" placeholder="Specialty / Category"><input name="Description" placeholder="Description"><input name="Price" type="number" min="0" step=".01" placeholder="Price"><select name="Status"><option>Available</option><option>Unavailable</option></select><button class="primary">Add Service</button></form>
@foreach(var x in services){<form method="post" action="/Content/UpdateService" class="form" style="margin:12px 0;padding:12px;border:1px solid #ddd">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"><input name="name" value="@x.Name" required><input name="category" value="@x.Category"><input name="description" value="@x.Description"><input name="price" type="number" min="0" step=".01" value="@x.Price"><select name="status"><option selected="@(x.Status=="Available")">Available</option><option selected="@(x.Status=="Unavailable")">Unavailable</option></select><button>Save Changes</button></form><form method="post" action="/Content/DeleteService" onsubmit="return confirm('Delete this service?')">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"><button>Delete @x.Name</button></form>}</div>
<div class="panel"><h3>Add Clinic Branch</h3><form method="post" action="/Content/AddLocation" class="form">@Html.AntiForgeryToken()<input name="Name" required placeholder="Branch"><input name="Address" placeholder="Address"><input name="Hours" placeholder="Operating hours"><input name="Contact" placeholder="Contact"><button class="primary">Add Branch</button></form>
@foreach(var x in locations){<form method="post" action="/Content/UpdateLocation" class="form" style="margin:12px 0;padding:12px;border:1px solid #ddd">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"><input name="name" value="@x.Name" required><input name="address" value="@x.Address"><input name="hours" value="@x.Hours"><input name="contact" value="@x.Contact"><button>Save Changes</button></form><form method="post" action="/Content/DeleteLocation" onsubmit="return confirm('Delete this branch?')">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"><button>Delete @x.Name</button></form>}</div>
<div class="panel"><h3>Add Patient Resource / FAQ / Announcement</h3><form method="post" action="/Content/AddResource" class="form">@Html.AntiForgeryToken()<input name="Title" required placeholder="Title"><input name="Category" placeholder="Category"><textarea name="Content" placeholder="Content"></textarea><select name="Published"><option value="true">Published</option><option value="false">Draft</option></select><button class="primary">Add Resource</button></form>
@foreach(var x in resources){<form method="post" action="/Content/UpdateResource" class="form" style="margin:12px 0;padding:12px;border:1px solid #ddd">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"><input name="title" value="@x.Title" required><input name="category" value="@x.Category"><textarea name="content">@x.Content</textarea><label>Published <input type="checkbox" name="published" value="true" checked="@x.Published"></label><button>Save Changes</button></form><form method="post" action="/Content/DeleteResource" onsubmit="return confirm('Delete this resource?')">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"><button>Delete @x.Title</button></form>}</div>
