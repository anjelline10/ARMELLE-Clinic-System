@model List<LabRequest>

@{ViewData["Title"]="Laboratory";}<div class="panel"><form class="form" method="post" action="/Clinic/AddLab">@Html.AntiForgeryToken()<input name="Patient" placeholder="Patient" required><input name="Test" placeholder="Test requested" required><button class="primary">Create Request</button></form></div><div class="panel"><table><tr><th>Patient</th><th>Test</th><th>Status</th><th>Result</th><th>Action</th></tr>@foreach(var x in Model){<tr><td>@x.Patient</td><td>@x.Test</td><td>@x.Status</td><td>@x.Result</td><td><form method="post" action="/Clinic/LabResult">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"><input name="result" placeholder="Result"><button>Release</button></form></td></tr>}</table></div>
<section style="padding:20px;border:1px solid #ddd;margin:20px 0"><h2>Release Laboratory Result</h2><p>Enter the result through the existing form first. Only release authorized results; the patient portal displays Released records.</p><form method="post" action="/Clinic/ReleaseLab">@Html.AntiForgeryToken()<label>Laboratory Request ID <input name="id" type="number" min="1" required></label><button type="submit">Release Result</button></form></section>

<section class="panel"><h3>Delete Laboratory Request</h3><form method="post" action="/Clinic/DeleteLab">@Html.AntiForgeryToken()<select name="id">@foreach(var r in Model){<option value="@r.Id">#@r.Id — @r.Patient / @r.Test</option>}</select><button onclick="return confirm('Delete this laboratory record?')">Delete</button></form></section>
