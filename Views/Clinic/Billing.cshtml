@model List<Invoice>

@{ViewData["Title"]="Billing & Payments";}<div class="panel"><form class="form" method="post" action="/Clinic/AddInvoice">@Html.AntiForgeryToken()<input name="Patient" placeholder="Patient" required><input name="Service" placeholder="Service" required><input name="Amount" type="number" step=".01" placeholder="Amount"><input name="Discount" type="number" min="0" step=".01" placeholder="Discount (PHP)"><select name="PaymentMethod"><option>Cash</option><option>Card</option><option>GCash</option><option>Maya</option><option>HMO</option></select><button class="primary">Create Invoice</button></form></div><div class="panel"><table><tr><th>Patient</th><th>Service</th><th>Amount</th><th>Discount</th><th>Due</th><th>Method</th><th>Status</th><th>Action</th></tr>@foreach(var x in Model){<tr><td>@x.Patient</td><td>@x.Service</td><td>₱@x.Amount</td><td>₱@x.Discount</td><td>₱@(x.Amount-x.Discount)</td><td>@x.PaymentMethod</td><td>@x.Status</td><td>@if(x.Status!="Paid"){<form method="post" action="/Clinic/Pay">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"><select name="method"><option>Cash</option><option>Card</option><option>GCash</option><option>Maya</option><option>HMO</option></select><button>Mark Paid</button></form>}</td></tr>}</table></div>
<section class="panel"><h3>Update / Delete Invoice</h3><form method="post" action="/Clinic/UpdateInvoice">@Html.AntiForgeryToken()<select name="id">@foreach(var r in Model){<option value="@r.Id">#@r.Id — @r.Patient / @r.Service</option>}</select><input name="service" placeholder="Service" required/><input name="amount" type="number" min="0" step="0.01" required/><button>Update invoice</button></form><form method="post" action="/Clinic/DeleteInvoice">@Html.AntiForgeryToken()<select name="id">@foreach(var r in Model.Where(x=>x.Status!="Paid")){<option value="@r.Id">#@r.Id — @r.Patient</option>}</select><button onclick="return confirm('Delete unpaid invoice?')">Delete unpaid invoice</button></form></section>
