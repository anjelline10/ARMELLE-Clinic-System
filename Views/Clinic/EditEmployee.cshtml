@model Armelle.Models.Employee
@{ViewData["Title"]="Edit Employee";}
<div class="owner-head"><div><p class="eyebrow">OWNER MANAGEMENT</p><h1>Edit @Model.Name</h1><p>Update staff information, workforce access and profile photo. Changes are saved to MySQL.</p></div><a class="soft" href="/Clinic/Employees">← Back to Employees</a></div>
<form method="post" action="/Clinic/UpdateEmployee" enctype="multipart/form-data" class="owner-form owner-editor" style="display:grid">@Html.AntiForgeryToken()
<input type="hidden" name="Id" value="@Model.Id">
<label>Current Photo@if(!string.IsNullOrWhiteSpace(Model.PhotoPath)){<img src="@Model.PhotoPath" style="width:110px;height:110px;object-fit:cover;border-radius:22px;display:block;margin-top:8px">}</label>
<label>Upload New Photo<input type="file" name="photo" accept="image/png,image/jpeg,image/webp"></label>
<label>Full Name<input name="Name" value="@Model.Name" required></label><label>Role / Position<input name="Role" value="@Model.Role" required></label>
<label>Department<input name="Department" value="@Model.Department"></label><label>Branch<input name="Branch" value="@Model.Branch"></label>
<label>Shift<input name="Shift" value="@Model.Shift"></label><label>Rate<input name="Rate" type="number" step=".01" value="@Model.Rate"></label>
<label>Email<input name="Email" type="email" value="@Model.Email"></label><label>Contact<input name="Contact" value="@Model.Contact"></label>
<label>Reset Personal Password<input name="newPassword" type="password" placeholder="Leave blank to keep current password"></label>
<label class="wide">Bio<textarea name="Bio" rows="4">@Model.Bio</textarea></label>
<button class="primary wide" type="submit">Save Changes</button>
</form>
