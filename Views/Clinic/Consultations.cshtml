@model List<Consultation>

@{ViewData["Title"]="Consultations";}<div class="panel"><h3>Add Record</h3><form class="form" method="post" action="/Clinic/AddConsultation">@Html.AntiForgeryToken()<input name="Patient" placeholder="Patient" required><input name="Doctor" placeholder="Doctor"><input name="Vitals" placeholder="Vitals"><input name="Notes" placeholder="Clinical notes"><input name="Diagnosis" placeholder="Diagnosis"><input name="Prescription" placeholder="Prescription"><button class="primary">Save</button></form></div><div class="panel"><table><tr><th>Patient</th><th>Doctor</th><th>Vitals</th><th>Diagnosis</th><th>Prescription</th><th>Date</th></tr>@foreach(var x in Model){<tr><td>@x.Patient</td><td>@x.Doctor</td><td>@x.Vitals</td><td>@x.Diagnosis</td><td>@x.Prescription</td><td>@x.Date</td></tr>}</table></div>
<section style="padding:20px;border:1px solid #ddd;margin:20px 0"><h2>Prescription Management (Demo / Physician-provided only)</h2><p>Choose an existing consultation to edit. The patient will see the saved record. Do not enter invented medical findings.</p><form method="post" action="/Clinic/UpdateConsultation">@Html.AntiForgeryToken()<label>Consultation ID <input type="number" min="1" name="id" required></label><label>Diagnosis <input name="diagnosis"></label><label>Prescription (doctor-provided information only) <textarea name="prescription" rows="4"></textarea></label><label>Notes <textarea name="notes" rows="2"></textarea></label><button type="submit">Save record</button></form></section>

<section class="panel"><h3>Edit / Remove Consultation</h3><p>Only record physician-provided findings. Demo documents must be labeled.</p><form method="post" action="/Clinic/DeleteConsultation">@Html.AntiForgeryToken()<select name="id" required>@foreach(var r in Model){<option value="@r.Id">#@r.Id — @r.Patient / @r.Doctor</option>}</select><button onclick="return confirm('Delete this consultation?')">Delete record</button></form></section>
