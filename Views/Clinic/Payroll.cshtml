@model List<Payroll>

@{ViewData["Title"]="Payroll";}<div class="panel"><form class="form" method="post" action="/Clinic/AddPayroll">@Html.AntiForgeryToken()<input name="Employee" placeholder="Employee" required><input name="RegularPay" type="number" step=".01" placeholder="Regular pay"><input name="OvertimePay" type="number" step=".01" placeholder="Approved OT"><input name="Deductions" type="number" step=".01" placeholder="Deductions"><button class="primary">Compute & Save</button></form></div><div class="panel"><table><tr><th>Employee</th><th>Regular</th><th>Approved OT</th><th>Deductions</th><th>Net</th><th>Status</th><th>Action</th></tr>@foreach(var x in Model){<tr><td>@x.Employee</td><td>₱@x.RegularPay</td><td>₱@x.OvertimePay</td><td>₱@x.Deductions</td><td><b>₱@x.NetPay</b></td><td>@x.Status</td><td><form method="post" action="/Clinic/PayrollStatus">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"><button name="status" value="Approved">Approve</button></form></td></tr>}</table></div>