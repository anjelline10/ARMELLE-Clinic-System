@model List<QueueEntry>

@{ViewData["Title"]="QR Check-In / Queue";}<div class="panel"><h3>Patient Check-In</h3><form class="form" method="post" action="/Clinic/CheckIn">@Html.AntiForgeryToken()<input name="patient" placeholder="Patient name" required><input name="department" placeholder="Department / Specialty" required><button class="primary">Check In & Generate Queue No.</button></form></div><div class="panel"><table><tr><th>Queue</th><th>Patient</th><th>Department</th><th>Check-In</th><th>Status</th><th>Action</th></tr>@foreach(var x in Model){<tr><td><b>@x.QueueNo</b></td><td>@x.Patient</td><td>@x.Department</td><td>@x.CheckInAt</td><td>@x.Status</td><td><form method="post" action="/Clinic/QueueStatus">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"><button name="status" value="In Consultation">Call</button><button name="status" value="Completed">Complete</button></form></td></tr>}</table></div>