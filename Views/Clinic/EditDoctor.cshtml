@model Armelle.Models.Doctor
@{ViewData["Title"]="Edit Doctor";}
<div class="owner-head"><div><p class="eyebrow">OWNER MANAGEMENT</p><h1>Edit @Model.Name</h1><p>Update doctor profile, schedule, availability, fee and photo.</p></div><a class="soft" href="/Clinic/Doctors">← Back to Doctors</a></div>
<form method="post" action="/Clinic/UpdateDoctor" enctype="multipart/form-data" class="owner-form owner-editor" style="display:grid">@Html.AntiForgeryToken()
<input type="hidden" name="Id" value="@Model.Id">
<label>Current Photo@if(!string.IsNullOrWhiteSpace(Model.PhotoPath)){<img src="@Model.PhotoPath" style="width:110px;height:110px;object-fit:cover;border-radius:22px;display:block;margin-top:8px">}</label><label>Upload New Photo<input type="file" name="photo" accept="image/png,image/jpeg,image/webp"></label>
<label>Name<input name="Name" value="@Model.Name" required></label><label>Credentials<input name="Credentials" value="@Model.Credentials"></label><label>Specialty<input name="Specialty" value="@Model.Specialty"></label><label>Branch<input name="Branch" value="@Model.Branch"></label><label>Room<input name="Room" value="@Model.Room"></label><label>Schedule<input name="Schedule" value="@Model.Schedule"></label><label>Consultation Fee<input name="ConsultationFee" type="number" step=".01" value="@Model.ConsultationFee"></label><label>Daily Limit<input name="DailyLimit" type="number" value="@Model.DailyLimit"></label><label>Status<input name="Status" value="@Model.Status"></label><label>Reset Personal Password<input name="newPassword" type="password" placeholder="Leave blank to keep current password"></label><label class="wide">Bio<textarea name="Bio" rows="4">@Model.Bio</textarea></label><button class="primary wide" type="submit">Save Doctor Changes</button>
</form>
