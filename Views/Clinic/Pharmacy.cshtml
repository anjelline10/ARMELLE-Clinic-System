@model List<Medicine>
@{ViewData["Title"]="Pharmacy & Inventory";var low=Model.Count(x=>x.Stock<=20);}
<div class="cards"><div class="card"><label>Inventory Items</label><b>@Model.Count</b></div><div class="card"><label>Low Stock</label><b>@low</b></div><div class="card"><label>Units On Hand</label><b>@Model.Sum(x=>x.Stock)</b></div></div><div class="panel"><h3>Add Medicine</h3><form class="form" method="post" action="/Clinic/AddMedicine">@Html.AntiForgeryToken()<input name="GenericName" placeholder="Generic name" required><input name="Brand" placeholder="Brand"><input name="Category" placeholder="Category"><input name="Strength" placeholder="Strength"><input name="Branch" placeholder="Branch"><input name="BatchNo" placeholder="Batch number"><input name="Supplier" placeholder="Supplier"><input name="Stock" type="number" min="0" placeholder="Initial stock"><input name="ReservedStock" type="number" min="0" placeholder="Reserved stock"><input name="CostPrice" type="number" step=".01" placeholder="Cost"><input name="Price" type="number" step=".01" placeholder="Selling price"><input name="Expiry" type="date"><button class="primary">Save Medicine</button></form></div><div class="panel"><h3>Inventory Ledger (Current Stock)</h3><div style="overflow-x:auto"><table><tr><th>Medicine</th><th>Branch</th><th>Batch</th><th>Stock</th><th>Reserved</th><th>Supplier</th><th>Price</th><th>Expiry</th><th>Stock In / Out</th></tr>@foreach(var x in Model){<tr><td><b>@x.GenericName</b><br>@x.Brand @x.Strength</td><td>@x.Branch</td><td>@x.BatchNo</td><td class="@(x.Stock<=20?"warn":"")">@x.Stock @(x.Stock<=20?"⚠ Low":"")</td><td>@x.ReservedStock</td><td>@x.Supplier</td><td>₱@x.Price</td><td>@x.Expiry?.ToShortDateString()</td><td><form method="post" action="/Clinic/AdjustStock" style="display:flex;gap:5px">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"><input name="quantity" type="number" min="1" value="1" style="width:68px"><button name="operation" value="In">+ In</button><button name="operation" value="Out">− Out</button></form></td></tr>}</table></div><p style="font-size:12px">Stock changes update MySQL. Full historical stock movement requires a separate inventory transactions table.</p></div>
<section class="panel"><h3>Edit Medicine</h3><form method="post" action="/Clinic/UpdateMedicine">@Html.AntiForgeryToken()<select name="id">@foreach(var r in Model){<option value="@r.Id">#@r.Id — @r.GenericName</option>}</select><input name="genericName" placeholder="Generic name" required/><input name="brand" placeholder="Brand"/><input name="strength" placeholder="Strength"/><input name="price" type="number" min="0" step="0.01" placeholder="Price" required/><input name="stock" type="number" min="0" placeholder="Stock" required/><button>Save medicine</button></form><form method="post" action="/Clinic/DeleteMedicine">@Html.AntiForgeryToken()<select name="id">@foreach(var r in Model){<option value="@r.Id">#@r.Id — @r.GenericName</option>}</select><button onclick="return confirm('Delete medicine?')">Delete medicine</button></form></section>
