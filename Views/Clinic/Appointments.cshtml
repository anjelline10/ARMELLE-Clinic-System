@model List<Appointment>

@{ViewData["Title"]="Appointments & Walk-Ins";}<div class="panel"><h3>Add Record</h3><form class="form" method="post" action="/Clinic/AddAppointment">@Html.AntiForgeryToken()<input name="Patient" placeholder="Patient" required><input name="Doctor" placeholder="Doctor" required><input name="Specialty" placeholder="Specialty"><input name="Schedule" type="datetime-local" required><select name="Type"><option>Appointment</option><option>Walk-In</option></select><button class="primary">Save</button></form></div><div class="panel"><table><tr><th>Patient</th><th>Doctor</th><th>Schedule</th><th>Type</th><th>Status</th><th>Action</th></tr>@foreach(var x in Model){<tr><td>@x.Patient</td><td>@x.Doctor</td><td>@x.Schedule</td><td>@x.Type</td><td>@x.Status</td><td><form method="post" action="/Clinic/AppointmentStatus">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"><button name="status" value="Completed">Complete</button><button name="status" value="Cancelled">Cancel</button></form></td></tr>}</table></div>
<section class="panel"><h3>Owner Appointment Approval</h3><form method="post" action="/Clinic/AppointmentStatus">@Html.AntiForgeryToken()<select name="id">@foreach(var r in Model){<option value="@r.Id">#@r.Id — @r.Patient / @r.Doctor</option>}</select><select name="status"><option>Pending</option><option>Confirmed</option><option>In Progress</option><option>Consultation Done</option><option>Completed</option><option>Cancelled</option></select><button>Update status</button></form><p>Completing a consultation records its history; no medicine or signature is fabricated.</p></section>
