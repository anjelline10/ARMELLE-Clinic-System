@{Layout=null;}<!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/css/site.css"><title>ARMELLE Patient Login</title></head><body class="login patientlogin"><div class="loginbox"><img src="/images/armelle-logo.png" class="loginlogo" alt="ARMELLE"><h2>Patient Login</h2><p>Access appointments, results, prescriptions, pharmacy orders and billing.</p><form method="post"><input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl"><input name="username" placeholder="Patient username" required><input name="password" type="password" placeholder="Password" required><button class="primary">Sign In</button></form>@if(ViewBag.Error!=null){<div class="error">@ViewBag.Error</div>}<p>New patient? <a href="/Auth/Register?returnUrl=@Uri.EscapeDataString((string?)ViewBag.ReturnUrl ?? "")">Create Patient Account</a></p><div class="workforce-entry"><small>ARMELLE team member?</small><a href="/Auth/WorkforceLogin">Authorized Workforce Portal →</a></div><p><a href="/">← Public Website</a></p></div></body></html>
