
@{
    Layout = null;
    ViewData["Title"] = "Owner Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>ARMELLE | Owner Login</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-height: 100vh;
            display: grid;
            place-items: center;
            font-family: "Segoe UI", Arial, sans-serif;
            background: linear-gradient(135deg, #fff7fa, #f1dce6);
            color: #442b35;
        }

        .login-container {
            width: min(480px, 94vw);
            background: white;
            padding: 35px;
            border-radius: 24px;
            box-shadow: 0 18px 55px #87385220;
        }

        .brand {
            color: #873852;
            font-size: 27px;
            font-weight: 800;
            letter-spacing: 2px;
            text-align: center;
        }

        h1 {
            text-align: center;
            font-size: 25px;
            margin: 20px 0 5px;
        }

        .subtitle {
            text-align: center;
            color: #8c7180;
            margin-bottom: 25px;
        }

        label {
            display: block;
            font-weight: 650;
            margin: 17px 0 8px;
            font-size: 14px;
        }

        select,
        input {
            width: 100%;
            padding: 14px;
            border: 1px solid #e5ccd7;
            border-radius: 11px;
            font-size: 15px;
            background: white;
        }

        select:focus,
        input:focus {
            outline: 2px solid #dba5bb;
        }

        .owner-note {
            margin-top: 8px;
            font-size: 12px;
            color: #806875;
        }

        .login-button {
            width: 100%;
            background: #873852;
            color: white;
            border: none;
            padding: 15px;
            border-radius: 12px;
            font-size: 15px;
            font-weight: 700;
            margin-top: 25px;
            cursor: pointer;
        }

        .login-button:hover {
            background: #6d2941;
        }

        .error {
            padding: 13px;
            background: #fff0f0;
            color: #a12e3d;
            border-radius: 9px;
            margin: 15px 0;
        }

        .back {
            text-align: center;
            margin-top: 22px;
        }

        .back a {
            color: #873852;
            text-decoration: none;
            font-weight: 600;
        }

        .security-note {
            margin-top: 18px;
            text-align: center;
            color: #987f8b;
            font-size: 12px;
        }
    </style>
</head>

<body>
    <div class="login-container">

        <div class="brand">✦ ARMELLE</div>

        <h1>Owner Portal</h1>

        <p class="subtitle">
            Multi-Specialty Center Management System
        </p>

        @if (ViewBag.Error != null)
        {
            <div class="error">
                @ViewBag.Error
            </div>
        }

        <form method="post"
              action="@Url.Action("OwnerLogin", "Auth")">

            @Html.AntiForgeryToken()

            <label for="username">
                Select Owner Account
            </label>

            <select id="username"
                    name="username"
                    required>

                <option value="">
                    -- Select Owner --
                </option>

                <option value="angeline">
                    Angeline P. Labrado — CEO, COO & Owner
                </option>

                <option value="ricky">
                    Ricky Jr. B. Diestro — CTO & Co-Founder
                </option>

                <option value="mica">
                    Mica P. Gonzales — CFO & Co-Founder
                </option>

            </select>

            <p class="owner-note">
                Select your authorized owner account.
            </p>

            <label for="password">
                Password
            </label>

            <input id="password"
                   name="password"
                   type="password"
                   autocomplete="current-password"
                   placeholder="Enter your password"
                   required />

            <button class="login-button"
                    type="submit">
                Sign In to Owner Dashboard →
            </button>

        </form>

        <p class="security-note">
            Authorized ARMELLE owners only
        </p>

        <div class="back">
            <a href="@Url.Action("Index", "Public")">
                ← Back to Public Website
            </a>
        </div>

    </div>
</body>
</html>
